# Copy to .env for local dev. Never commit .env to git.
# All values below are placeholders for local development only.

# Shared secret sent as the X-API-Key header on all non-public endpoints.
# CHANGE THIS to a long random string before any real deployment.
API_KEY=dev-api-key-change-me

# Port the API listens on (Render sets this automatically; keep 8000 locally).
PORT=8000

# Comma-separated browser origins allowed to call the API via CORS.
# Leave empty = no CORS (most restrictive). Example for a hosted dashboard:
# CORS_ALLOWED_ORIGINS=https://your-shop.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# Logging: debug | info | warning | error
LOG_LEVEL=info
